# --- Supabase (required) ------------------------------------------------------
# Public values. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# SECRET. Bypasses Row Level Security.
# Project Settings -> API -> service_role key. Server-side only. NEVER commit.
SUPABASE_SERVICE_ROLE_KEY=

# Safaricom Daraja credentials. Use sandbox credentials while testing, then switch to production.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Use the shortcode supplied for the selected Daraja environment.
# Production: your approved business shortcode (for this project: 542542).
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a public HTTPS endpoint registered in the Daraja portal.
MPESA_CALLBACK_URL=https://your-domain.example/api/payments/mpesa/callback
# Use CustomerBuyGoodsOnline for Till, CustomerPayBillOnline for PayBill.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# --- Browser push ID verification reminders ----------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@herlookutaskninja.vercel.app
CRON_SECRET=
# Create the first administrator by registering normally and promoting the
# account with the SQL instructions in README.md.

# --- Production (Vercel) ------------------------------------------------------
# `.env.local` is git-ignored, so it is NEVER uploaded to Vercel. Add the values
# above to the project instead:
#
#   Vercel Dashboard -> Project -> Settings -> Environment Variables
#   (tick Production, Preview and Development), then redeploy.
#
# Or from this folder, after `vercel login` and `vercel link`:
#
#   npx vercel env add NEXT_PUBLIC_SUPABASE_URL production
#   npx vercel env add NEXT_PUBLIC_SUPABASE_ANON_KEY production
#   npx vercel env add SUPABASE_SERVICE_ROLE_KEY production
#   npx vercel --prod
#
# NEXT_PUBLIC_* values are inlined at BUILD time: changing them only takes effect
# on a new deployment. Without them, /api/auth/* returns
# "Supabase is not configured. Set NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY." and sign-up/sign-in fail.
