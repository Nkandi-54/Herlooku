# --- Supabase (required) ------------------------------------------------------
# Public values. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# SECRET. Bypasses Row Level Security.
# Project Settings -> API -> service_role key. Server-side only. NEVER commit.
SUPABASE_SERVICE_ROLE_KEY=

# Safaricom Daraja credentials. Use sandbox credentials while testing, then switch to production.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# PayBill shortcode clients pay into. Production value: 542542.
MPESA_SHORTCODE=542542
MPESA_PASSKEY=
# Must be a public HTTPS endpoint registered in the Daraja portal.
MPESA_CALLBACK_URL=https://your-domain.example/api/payments/mpesa/callback
# Use CustomerBuyGoodsOnline for Till, CustomerPayBillOnline for PayBill.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# The PayBill account number credited for each booking. Production value: 01410637946150.
MPESA_ACCOUNT_NUMBER=01410637946150

# First administrator, provisioned automatically on first boot. Change before going live.
ADMIN_EMAIL=admin@your-domain.example
ADMIN_NAME=Platform Administrator
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Set to true once to rotate the admin password from ADMIN_PASSWORD, then remove it.
ADMIN_PASSWORD_RESET=false
